{
  "name": "@ximu3/process-list",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform process queries and foreground ownership for Node.js",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.zh-CN.md",
    "index.js",
    "index.d.ts",
    "native/binding.js",
    "native/targets.js"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/ximu3/process-list.git"
  },
  "license": "MIT",
  "keywords": [
    "process",
    "system",
    "foreground",
    "node-api",
    "rust",
    "windows",
    "macos",
    "linux"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "napi": {
    "binaryName": "process-list",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "pnpm build:js && napi build --platform --release --no-js --output-dir native --dts addon.d.ts -- --locked",
    "build:debug": "pnpm build:js && napi build --platform --no-js --output-dir native --dts addon.d.ts -- --locked",
    "build:js": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/api.test.ts test/boundary.test.ts test/linux.test.ts test/targets.test.ts",
    "test:rust": "cargo test --locked --no-default-features",
    "test:hooks": "node --test test/hooks.test.ts",
    "test:tooling": "node --test test/ci.test.ts test/publication.test.ts test/metadata.test.ts",
    "test:package": "node --experimental-strip-types scripts/verify-package.ts",
    "test:types": "tsc -p tsconfig.package.json",
    "typecheck": "tsc -p tsconfig.json",
    "check:format": "prettier --check",
    "check:docs": "node scripts/check-docs.ts",
    "check:rust-format": "cargo fmt --check",
    "check:rust": "cargo clippy --locked --all-targets -- -D warnings",
    "lint": "pnpm check:format . && pnpm check:rust-format && pnpm check:rust",
    "format": "prettier --write . && cargo fmt",
    "check": "pnpm lint && pnpm typecheck && pnpm test:types && pnpm check:docs && pnpm test:tooling && pnpm test:rust && pnpm test && pnpm test:package && pnpm test:hooks",
    "verify": "pnpm build:debug && pnpm check",
    "hooks:install": "node scripts/install-hooks.ts",
    "hooks:uninstall": "node scripts/uninstall-hooks.ts",
    "prepare": "node scripts/install-hooks.ts",
    "version:sync": "node scripts/version.ts",
    "packages:assemble": "node scripts/assemble.ts"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.9.0",
    "@types/node": "^22.19.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "yaml": "2.9.0"
  },
  "prettier": {
    "printWidth": 110,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  }
}
