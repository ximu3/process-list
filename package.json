{
  "name": "@ximu3/process-list",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform process queries and foreground ownership for Node.js",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native/binding.js",
    "native/binding.d.ts",
    "native/targets.js"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/ximu3/process-list.git"
  },
  "license": "MIT",
  "keywords": [
    "process",
    "system",
    "foreground",
    "node-api",
    "rust",
    "windows",
    "macos",
    "linux"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "napi": {
    "binaryName": "process-list",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --no-js --output-dir native --dts binding.d.ts -- --locked",
    "build:debug": "napi build --platform --no-js --output-dir native --dts binding.d.ts -- --locked",
    "test": "node --test test/*.test.js",
    "test:rust": "cargo test --locked --no-default-features",
    "test:hooks": "node --test test/hooks.test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:format": "prettier --check",
    "check:rust-format": "cargo fmt --check",
    "check:rust": "cargo clippy --locked --all-targets -- -D warnings",
    "lint": "pnpm check:format . && pnpm check:rust-format && pnpm check:rust",
    "format": "prettier --write . && cargo fmt",
    "check": "pnpm lint && pnpm typecheck && pnpm test:rust && pnpm test && pnpm test:package && pnpm test:hooks",
    "verify": "pnpm build:debug && pnpm check",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/uninstall-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "version:sync": "node scripts/version.mjs",
    "packages:assemble": "node scripts/assemble.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.9.0",
    "@types/node": "^22.19.0",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  },
  "prettier": {
    "printWidth": 110,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  }
}
